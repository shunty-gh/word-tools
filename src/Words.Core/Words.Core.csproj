<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The engine. No console, file system or UI dependencies: the CLI, MAUI and Blazor
    front ends all consume this project unchanged. Keep it that way.
  -->

  <!--
    The built lexicon travels with the assembly, so every front end works without a
    deployment step. Conditional so a clone with no artefact yet still builds — the
    failure then surfaces at runtime from EmbeddedLexicon, which says how to fix it.
  -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)../../data/lexicon.gz')">
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../data/lexicon.gz"
                      LogicalName="Words.Core.lexicon.gz" />
  </ItemGroup>

  <!--
    The word lists' licences require their notices to travel with anything distributed, so
    they are embedded rather than left as files beside the binary.
  -->
  <ItemGroup>
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../data/sources/esdb-COPYRIGHT.txt"
                      LogicalName="Words.Core.licences.esdb.txt" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../data/sources/nediger-LICENSE.txt"
                      LogicalName="Words.Core.licences.nediger.txt" />
  </ItemGroup>

</Project>
