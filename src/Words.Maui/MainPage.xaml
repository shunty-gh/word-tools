<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Words.Maui.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Words.Maui.ViewModels"
    x:DataType="vm:SearchViewModel"
    Shell.NavBarIsVisible="False"
    Title="Words">

    <Grid Padding="20,16" RowSpacing="14" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">

        <!-- Two modes, so a switch rather than a list. The inactive side dims, so the current
             mode is visible without reading (UI.md: make state visible). -->
        <HorizontalStackLayout Grid.Row="0" Spacing="10" HorizontalOptions="Center">
            <Label Text="Crossword" FontSize="17" VerticalOptions="Center" Opacity="{Binding CrosswordOpacity}" />
            <Switch IsToggled="{Binding IsAnagram}" VerticalOptions="Center" />
            <Label Text="Anagram" FontSize="17" VerticalOptions="Center" Opacity="{Binding AnagramOpacity}" />
        </HorizontalStackLayout>

        <!-- Spell check and prediction off: macOS otherwise substitutes a typed "..." with a
             single ellipsis mid-entry. The parser understands one anyway, but the field
             should show what was typed. -->
        <Entry
            Grid.Row="1"
            Text="{Binding Query}"
            Placeholder="{Binding Placeholder}"
            ClearButtonVisibility="WhileEditing"
            ReturnCommand="{Binding SearchCommand}"
            IsSpellCheckEnabled="False"
            IsTextPredictionEnabled="False" />

        <!--
            The query drawn as squares of the grid. Its job is to show how long the answer
            will be, which otherwise has to be counted by eye. Wraps, because a long pattern
            will not fit a phone on one line.
        -->
        <FlexLayout
            Grid.Row="2"
            IsVisible="{Binding HasCells}"
            Wrap="Wrap"
            JustifyContent="Start"
            BindableLayout.ItemsSource="{Binding Cells}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="vm:LetterCell">
                    <Border Style="{StaticResource Cell}" Margin="0,0,4,4">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsKnown}" Value="False">
                                <Setter Property="BackgroundColor"
                                        Value="{AppThemeBinding Light={StaticResource CellLight}, Dark={StaticResource CellDark}}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{Binding Letter}" Style="{StaticResource CellLetter}" />
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </FlexLayout>

        <VerticalStackLayout Grid.Row="3" Spacing="14">
        <HorizontalStackLayout Spacing="10" IsVisible="{Binding IsAnagram}">
            <Switch IsToggled="{Binding Compose}" VerticalOptions="Center" />
            <Label Text="Build answers from several words" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <Border Style="{StaticResource Panel}" Padding="16,14" IsVisible="{Binding ShowOptions}">
            <VerticalStackLayout Spacing="12">

                <HorizontalStackLayout Spacing="12">
                    <Label Text="Order" VerticalOptions="Center" WidthRequest="76" />
                    <Picker ItemsSource="{Binding SortOrders}" SelectedIndex="{Binding SortIndex}" WidthRequest="190" />
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="12">
                    <Switch IsToggled="{Binding OnlyMyWords}" VerticalOptions="Center" />
                    <Label Text="Only words I added" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="12">
                    <Switch IsToggled="{Binding IncludeRacy}" VerticalOptions="Center" />
                    <Label Text="Include rude words" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!--
                    Where the Define and Synonyms buttons on an answer go. An app preference
                    rather than a query option, but this panel is where anything adjustable
                    already lives, and a second settings surface for one picker would be one
                    more place to look. Google by default, so most people never open it.
                -->
                <HorizontalStackLayout Spacing="12">
                    <Label Text="Look up in" VerticalOptions="Center" WidthRequest="76" />
                    <Picker ItemsSource="{Binding SearchEngineNames}" SelectedIndex="{Binding SearchEngineIndex}" WidthRequest="190" />
                </HorizontalStackLayout>

                <!-- Only meaningful while composing, so only shown then. -->
                <HorizontalStackLayout Spacing="12" IsVisible="{Binding Compose}">
                    <Label Text="Build from" VerticalOptions="Center" WidthRequest="76" />
                    <Picker ItemsSource="{Binding WordCounts}" SelectedIndex="{Binding WordCountIndex}" WidthRequest="130" />
                    <Label Text="of" VerticalOptions="Center" />
                    <Picker ItemsSource="{Binding MinLengths}" SelectedIndex="{Binding MinLengthIndex}" WidthRequest="140" />
                    <Label Text="or more" VerticalOptions="Center" />
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </Border>
        </VerticalStackLayout>

        <HorizontalStackLayout Grid.Row="4" Spacing="10">
            <Button Text="Search" Style="{StaticResource PrimaryButton}" Command="{Binding SearchCommand}" />
            <Button Text="Add word" Style="{StaticResource SecondaryButton}" Clicked="OnAddWordClicked" />
            <Button Text="{Binding OptionsLabel}" Style="{StaticResource SecondaryButton}" Command="{Binding ToggleOptionsCommand}" />
        </HorizontalStackLayout>

        <Border Grid.Row="5" Style="{StaticResource Panel}" Padding="0">
            <CollectionView ItemsSource="{Binding Answers}" HorizontalScrollBarVisibility="Never">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:AnswerRow">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" Padding="16,6" ColumnSpacing="8">
                            <!-- Truncates rather than pushing the buttons off a phone's width. -->
                            <Label
                                Grid.Column="0"
                                Text="{Binding Answer}"
                                Style="{StaticResource Answer}"
                                LineBreakMode="TailTruncation" />
                            <!-- A word, not a colour: the tag has to survive in black and white. -->
                            <Label
                                Grid.Column="1"
                                Text="{Binding Tag}"
                                Style="{StaticResource Muted}"
                                FontSize="13"
                                VerticalOptions="Center" />
                            <!--
                                The solver says which words fit, never what they mean. These
                                two ask the user's own browser, which is where they would have
                                gone next anyway. Words rather than icons, because no glyph
                                for "thesaurus" is guessable (UI.md), and outlined buttons
                                rather than coloured text, because a thing you can press has
                                to look like one.

                                The command lives on the view model, which is the page's
                                binding context and so is found as an ancestor from inside the
                                row; the parameter is the row itself.
                            -->
                            <Button
                                Grid.Column="2"
                                Text="Define"
                                Style="{StaticResource RowButton}"
                                IsVisible="{Binding CanLookUp}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}}, Path=DefineCommand}"
                                CommandParameter="{Binding .}" />
                            <Button
                                Grid.Column="3"
                                Text="Synonyms"
                                Style="{StaticResource RowButton}"
                                IsVisible="{Binding CanLookUp}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}}, Path=SynonymsCommand}"
                                CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label
                        Text="{Binding EmptyMessage}"
                        Style="{StaticResource Muted}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Margin="24" />
                </CollectionView.EmptyView>
            </CollectionView>
        </Border>

        <Grid Grid.Row="6" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <ActivityIndicator Grid.Column="0" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Grid.Column="1" Text="{Binding Status}" Style="{StaticResource Muted}" VerticalOptions="Center" />
            <Button Grid.Column="2" Text="About" Style="{StaticResource SecondaryButton}" FontSize="15" Clicked="OnAboutClicked" />
        </Grid>

    </Grid>

</ContentPage>
