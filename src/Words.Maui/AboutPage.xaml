<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Words.Maui.AboutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:core="clr-namespace:Words.Core;assembly=Words.Core"
    Title="About">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label Text="Words" FontSize="30" FontAttributes="Bold" />
            <Label Text="A crossword and anagram solver for British puzzles." FontSize="17" />

            <!--
                The app's own terms, in the same shape as the word lists' below rather than
                behind a "view licence" tap: Apache 2.0 wants a copy of the licence to reach
                whoever the app reaches, and one screen that simply shows everything is both
                fewer decisions for the reader and harder to get wrong at release.
            -->
            <VerticalStackLayout Spacing="8" Margin="0,16,0,0">
                <Label Text="{Binding AppLicence.Source}" FontAttributes="Bold" FontSize="19" />
                <Label Text="{Binding AppLicence.Summary}" />
                <Label Text="{Binding AppLicence.Text}" Style="{StaticResource Muted}" FontSize="13" FontFamily="Monospace" />
            </VerticalStackLayout>

            <Label
                Text="The word lists bundled with this app are used under the following terms."
                Style="{StaticResource Muted}"
                Margin="0,16,0,0" />

            <!--
                Not decoration: both word lists require their notice to accompany anything
                distributed, so this screen is a release requirement.
            -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding WordListLicences}" Spacing="24">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="core:Licence">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Source}" FontAttributes="Bold" FontSize="19" />
                            <Label Text="{Binding Summary}" />
                            <Label Text="{Binding Text}" Style="{StaticResource Muted}" FontSize="13" FontFamily="Monospace" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
                <BindableLayout.EmptyViewTemplate>
                    <DataTemplate>
                        <Label Text="No licences found — this is a packaging fault." TextColor="Red" FontSize="16" />
                    </DataTemplate>
                </BindableLayout.EmptyViewTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
