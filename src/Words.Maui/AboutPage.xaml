<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Words.Maui.AboutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:core="clr-namespace:Words.Core;assembly=Words.Core"
    Title="About">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label Text="Words" FontSize="30" FontAttributes="Bold" />
            <Label Text="A crossword and anagram solver for British puzzles." FontSize="17" />

            <Label
                Text="The word lists bundled with this app are used under the following terms."
                FontSize="16"
                Margin="0,16,0,0" />

            <!--
                Not decoration: both word lists require their notice to accompany anything
                distributed, so this screen is a release requirement.
            -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Licences}" Spacing="24">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="core:LexiconLicence">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Source}" FontAttributes="Bold" FontSize="19" />
                            <Label Text="{Binding Summary}" FontSize="16" />
                            <Label Text="{Binding Text}" FontSize="13" FontFamily="Monospace" Opacity="0.75" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
                <BindableLayout.EmptyViewTemplate>
                    <DataTemplate>
                        <Label Text="No licences found — this is a packaging fault." TextColor="Red" FontSize="16" />
                    </DataTemplate>
                </BindableLayout.EmptyViewTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
